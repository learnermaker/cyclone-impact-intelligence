# ── Dependencies ─────────────────────────────────────────────
node_modules/
.pnpm-store/

# ── Next.js build output ──────────────────────────────────────
.next/
out/

# ── Environment / Secrets ─────────────────────────────────────
# Never commit real credentials. Only .env.example is tracked.
.env
.env.local
.env.*.local
.env.production

# ── Raw geospatial datasets ───────────────────────────────────
# Raw source data is large and must not be committed.
# Processed/derived compact assets in data/processed/ ARE committed.
data/raw/
# actual/ contains post-event Copernicus/Sentinel-1 validation geometry.
# Ignore all files in the directory by default (raw imagery, large GeoTIFFs, etc.)
# EXCEPTION: the compact derived Sentinel-1 JSON product IS committed — it is
# a small processed artifact, not raw satellite data, and required for replay
# evaluation at submission/deployment time.
data/historical/fani/actual/*
!data/historical/fani/actual/sentinel1_flood_extent.json

# ── GEE pipeline outputs ──────────────────────────────────────
pipelines/gee/outputs/
pipelines/osm/outputs/
pipelines/worldpop/outputs/
pipelines/copernicus/outputs/

# ── Playwright ────────────────────────────────────────────────
test-results/
playwright-report/

# ── Coverage ─────────────────────────────────────────────────
coverage/

# ── Docker ───────────────────────────────────────────────────
.dockerignore.local

# ── OS / Editor ──────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/settings.json
.idea/

# ── Logs ─────────────────────────────────────────────────────
*.log
npm-debug.log*
pnpm-debug.log*

# ── TypeScript ────────────────────────────────────────────────
*.tsbuildinfo
