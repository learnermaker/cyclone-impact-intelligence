# ============================================================
# Cyclone Impact Intelligence — Environment Variables
# Copy to .env.local for local development.
# NEVER commit .env.local or any file containing real secrets.
# ============================================================

# ── Gemini API ────────────────────────────────────────────────
# Required for AI-assisted explanation and advisory generation.
# App degrades gracefully (deterministic fallback) when absent.
# Obtain from: https://ai.google.dev/gemini-api/docs/api-key
GEMINI_API_KEY=

# Gemini model to use. Must match an available stable model ID.
# ⚠️  IMPORTANT: gemini-3.7-flash (or newer) is required for function calling.
#     Using gemini-3.1-flash-lite will trigger the text-only retry path —
#     the app still works but tool-augmented explanations are not available.
# Verified stable models (September 2026): gemini-3.7-flash
# See: https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.7-flash

# ── Google Cloud ──────────────────────────────────────────────
# Required for Cloud Run deployment; not needed for local dev.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_REGION=asia-south1

# ── Earth Engine ──────────────────────────────────────────────
# Required only for running GEE preprocessing pipeline scripts.
# NOT required for primary demo (uses precomputed assets).
# Register at: https://earthengine.google.com
EARTHENGINE_PROJECT=

# ── Live Data Adapters ────────────────────────────────────────
# Both optional. Primary demo works entirely without them.
# Defaults shown below are the public free-tier endpoints.
GDACS_BASE_URL=https://www.gdacs.org/gdacsapi/api
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# ── Map ───────────────────────────────────────────────────────
# MapLibre basemap style URL.
# Default: OpenFreeMap public instance (free, no key required).
# Falls back to bundled local style if this is empty.
# See: https://openfreemap.org
MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# ── Advisory Dispatch ─────────────────────────────────────────
# Simulated webhook endpoint for advisory dispatch.
# Defaults to the local simulation endpoint.
DISPATCH_WEBHOOK_URL=http://localhost:3000/api/webhook/receive
DISPATCH_WEBHOOK_SECRET=

# ── Application ───────────────────────────────────────────────
# NODE_ENV is set automatically by Next.js.
# Set LOG_LEVEL to "debug" for verbose engine logging during dev.
LOG_LEVEL=info
